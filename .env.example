# Backend environment variables
# Copy this file to `.env` and fill in the values. Never commit the real `.env` file.

# Server
PORT=5000
NODE_ENV=development

# Database - MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/coursemaster

# JWT - use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret

# Optional - a user who sends this key when registering becomes an admin.
# Leave empty to disable admin registration through the API.
ADMIN_REGISTRATION_KEY=

# Optional - welcome emails (the app works without them)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173

# Optional - email of the admin created by `npm run seed` (default: admin@coursemaster.com)
# ADMIN_EMAIL=admin@coursemaster.com
